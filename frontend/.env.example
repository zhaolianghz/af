# Frontend environment variables
# Copy to .env.local and adjust as needed

# Base URL for the Go backend API (NO trailing slash).
# In Vite dev, the Vite proxy also forwards /api → http://localhost:8080,
# so relative calls work too. This variable is used for absolute URLs
# such as /healthz that live outside the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional: enable verbose API logging in the browser console
VITE_API_DEBUG=false
