# =============================================================================
# A-Stock Selector System - Environment Variables
# Copy this file to `.env` and adjust values for your local setup.
# NEVER commit a real `.env` file.
# =============================================================================

# ---------- Application ----------
# APP_ENV controls logging format and other runtime behavior.
#   development: console-friendly, verbose
#   production:  JSON-structured, optimized
APP_ENV=development

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=15s

# API base path
API_BASE_PATH=/api/v1

# ---------- MySQL ----------
# Driver: mysql | sqlite | none
# - mysql: production (uses DB_HOST/PORT/USER/PASSWORD/NAME)
# - sqlite: tests/local dev (DB_NAME is the SQLite DSN, e.g. ":memory:",
#          "file::memory:?cache=shared", or "/tmp/af.db")
# - none:   DB-less mode (healthz will not report db status)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=astock_selector
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_LOG_LEVEL=info

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# ---------- Datasource (A3 territory) ----------
# Tushare / AKShare / BaoStock — pick one for production
DATASOURCE_PROVIDER=akshare
DATASOURCE_TOKEN=
DATASOURCE_TIMEOUT=10s
DATASOURCE_RETRY=3
DATASOURCE_CACHE_TTL=5m
DATASOURCE_RATE_LIMIT=60

# A3 multi-source chain. NOTE: the source LIST (which adapters + their
# base_urls) lives in the YAML config's `datasource.sources`, NOT in env
# — there is no DATASOURCE_SOURCES parser. The Docker stack uses
# config.docker.yaml, where the akshare source already points at
# http://sidecar:18800. Only the knobs below are env-overridable.

# Per-source circuit breaker (design.md §3.5 hard constraint):
#   5 failures within 5 minutes → open for 10 minutes.
DATASOURCE_FAIL_THRESHOLD=5
DATASOURCE_FAIL_WINDOW=5m
DATASOURCE_COOLDOWN=10m

# Cross-source price-consistency threshold (relative deviation).
# A pair that disagrees by more than 0.005 (0.5%) is flagged.
DATASOURCE_CONSISTENCY_THRESHOLD=0.005

# ---------- Notify (A4 territory) ----------
# Comma-separated list of enabled channels
NOTIFY_CHANNELS=email,wechat,feishu
NOTIFY_DEFAULT_CHANNEL=email

# Email
NOTIFY_EMAIL_SMTP_HOST=smtp.example.com
NOTIFY_EMAIL_SMTP_PORT=465
NOTIFY_EMAIL_USERNAME=noreply@example.com
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_FROM=noreply@example.com

# WeChat Work
NOTIFY_WECHAT_CORPID=
NOTIFY_WECHAT_AGENTID=
NOTIFY_WECHAT_CORPSECRET=

# Feishu
NOTIFY_FEISHU_WEBHOOK=

# ---------- A4 Multi-channel Notification ----------
# Webhook-based delivery to Feishu / DingTalk / WeCom group robots.
# Set at least one *_ENABLED=true and *_WEBHOOK_URL to activate a channel.
# Primary is tried first; fallbacks are walked in order on failure.
NOTIFY_CHANNEL_PRIMARY=feishu
NOTIFY_CHANNEL_RETRY_ATTEMPTS=3

# Feishu (Lark) — 自定义机器人 webhook
NOTIFY_CHANNEL_FEISHU_ENABLED=false
NOTIFY_CHANNEL_FEISHU_WEBHOOK_URL=
NOTIFY_CHANNEL_FEISHU_SECRET=
NOTIFY_CHANNEL_FEISHU_TIMEOUT=5s

# DingTalk — 群机器人 webhook
NOTIFY_CHANNEL_DINGTALK_ENABLED=false
NOTIFY_CHANNEL_DINGTALK_WEBHOOK_URL=
NOTIFY_CHANNEL_DINGTALK_SECRET=
NOTIFY_CHANNEL_DINGTALK_TIMEOUT=5s

# WeCom (企业微信) — 群机器人 webhook
NOTIFY_CHANNEL_WECOM_ENABLED=false
NOTIFY_CHANNEL_WECOM_WEBHOOK_URL=
NOTIFY_CHANNEL_WECOM_TIMEOUT=5s

# Circuit breaker (per-channel)
NOTIFY_CHANNEL_CB_FAILURE_THRESHOLD=5
NOTIFY_CHANNEL_CB_WINDOW=5m
NOTIFY_CHANNEL_CB_COOLDOWN=10m

# ---------- Cron / Scheduler ----------
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Shanghai
CRON_DAILY_SELECTION=0 15 * * 1-5

# ---------- Logging ----------
LOG_LEVEL=info
LOG_ENCODING=console
LOG_OUTPUT=stdout
LOG_FILE_PATH=

# ---------- Auth (§12) ----------
# Login gate. Default OFF (open API). Set AUTH_ENABLED=true to require a
# Bearer JWT on everything except ping/healthz/openapi/login.
#   - AUTH_JWT_SECRET: a long random string. Empty → an ephemeral one is
#     generated and logged (tokens die on restart) — set a stable secret.
#   - AUTH_ADMIN_PASSWORD: empty → a random one is generated + logged once
#     on first boot (when the users table is empty).
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=
AUTH_TOKEN_TTL=24h

# ---------- AI / LLM (§11, §14.9) ----------
# The runtime LLM provider chain is configured from the Settings page and
# stored in the DB (table llm_providers) — these env vars only seed the
# INITIAL client before any DB setting is saved. Leave AI_ENABLED=true to
# allow the assistant; with no provider configured it stays "disabled".
AI_ENABLED=true
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30s
